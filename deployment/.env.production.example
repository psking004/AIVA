# ==============================================================================
# AIVA PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Copy this file to your production deployment dashboard or .env.production file.
# Replace all CHANGE_ME placeholders with your actual production credentials.
# NEVER commit real production secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. PUBLIC & NON-SECRET CONFIGURATION
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=10000

# AI Model Routing Strategy
# Options: 'cloud-first' (recommended for 24/7 cloud backend), 'local-first'
AIVA_ROUTING_STRATEGY=cloud-first

# Primary Cloud Provider when cloud routing is engaged
# Options: 'openrouter', 'gemini'
AIVA_CLOUD_PROVIDER=openrouter

# Enable Cloud Inference capabilities
AIVA_CLOUD_ENABLED=true

# AI Generation Hyperparameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# Daily Cloud Quota & Cost Protection (limits daily requests and token bursts)
AIVA_MAX_CLOUD_REQUESTS_PER_DAY=1000
AIVA_MAX_OUTPUT_TOKENS=4096

# OpenRouter Configuration (Non-secret endpoints & model IDs)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_TIMEOUT_MS=45000

# Google Gemini Configuration (Non-secret model ID)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=45000

# Session Lifetime (seconds, 86400 = 24 hours)
SESSION_EXPIRY=86400

# Rate Limiting Configuration (requests per 60000ms TTL window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ==============================================================================
# 2. CLIENT-FACING / DOMAIN CONFIGURATION
# ==============================================================================

# Production CORS Origin Whitelist (Exact deployed frontend domain, NO wildcard '*')
# Example: https://aiva-app.vercel.app,https://aiva.yourdomain.com
CORS_ORIGIN=https://CHANGE_ME_FRONTEND_DOMAIN.com

# Production Frontend Web URL
FRONTEND_URL=https://CHANGE_ME_FRONTEND_DOMAIN.com

# Public API URL used by Web and Mobile Clients (No trailing slash)
# Web (Next.js): NEXT_PUBLIC_AIVA_API_URL
# Mobile (Expo): EXPO_PUBLIC_AIVA_API_URL
NEXT_PUBLIC_AIVA_API_URL=https://CHANGE_ME_BACKEND_DOMAIN.onrender.com
EXPO_PUBLIC_AIVA_API_URL=https://CHANGE_ME_BACKEND_DOMAIN.onrender.com

# ==============================================================================
# 3. SECRET CONFIGURATION (CRITICAL — MUST BE SECURED)
# ==============================================================================

# Database Connection Strings (Supabase PostgreSQL)
# Runtime App Connection (Transaction Pooler - Port 6543)
# Source: Supabase Project Settings -> Database -> Connection string (URI) -> Mode: Transaction
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Connection for Prisma Migrations & Schema operations (Port 5432)
# Source: Supabase Project Settings -> Database -> Connection string (URI) -> Mode: Session
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Redis Connection URL (Upstash Cloud Redis with TLS)
# Source: Upstash Console -> Redis Database -> Details -> REST / Connection String
# Format: rediss://default:[token]@[endpoint].upstash.io:6379
REDIS_URL=rediss://default:CHANGE_ME_UPSTASH_TOKEN@CHANGE_ME_ENDPOINT.upstash.io:6379

# Single-Owner Authentication JWT Secrets (Min 32 random characters each)
# Generate via: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX_OR_BASE64_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHAR_HEX_OR_BASE64_SECRET

# Cloud AI Provider API Keys
# OpenRouter API Key: Source from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME_OPENROUTER_API_KEY

# Google Gemini API Key: Source from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCHANGE_ME_GEMINI_API_KEY
