# AIVA Environment Configuration
# Copy this to .env.local or .env and fill in your values

# ============================================
# AI MODEL ROUTING & ORCHESTRATION
# ============================================
AIVA_ROUTING_STRATEGY=local-first
AIVA_CLOUD_PROVIDER=openrouter

# 1. LOCAL PROVIDER: Ollama (Qwen3 8B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=30000

# 2. CLOUD PROVIDER: OpenRouter (Qwen)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=45000

# 3. CLOUD PROVIDER: Google Gemini API (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=45000

# Cost & Quota Controls
AIVA_CLOUD_ENABLED=true
AIVA_MAX_OUTPUT_TOKENS=
AIVA_MAX_CLOUD_REQUESTS_PER_DAY=

# General AI Parameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ============================================
# DATABASE (Supabase / PostgreSQL)
# ============================================
# Runtime App Connection (Transaction Pooler - Port 6543 with PgBouncer for Cloud, or direct for local)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct Connection for Prisma Migrations (Session Mode - Port 5432)
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# ============================================
# REDIS (Upstash / Cloud / Local)
# ============================================
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# ============================================
# AUTHENTICATION (Single-Owner Security)
# ============================================
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-secure-random-string
SESSION_EXPIRY=86400

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
