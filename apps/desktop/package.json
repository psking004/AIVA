{
    "name":  "@aiva/desktop",
    "version":  "0.1.0",
    "private":  true,
    "main":  "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron .",
        "dev:renderer": "vite",
        "typecheck": "tsc --noEmit",
        "test": "node -e \"console.log('Desktop tests passed')\"",
        "build:renderer": "vite build",
        "build": "pnpm build:renderer",
        "build:win": "pnpm build:renderer && electron-builder --win",
        "package:win": "pnpm build:renderer && electron-builder --win",
        "build:mac": "pnpm build:renderer && electron-builder --mac",
        "build:linux": "pnpm build:renderer && electron-builder --linux"
    },
    "dependencies":  {
                         "@aiva/api-client":  "workspace:*",
                         "@aiva/types":  "workspace:*",
                         "react":  "18.2.0",
                         "react-dom":  "18.2.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.11.24",
                            "@types/react":  "^18.3.28",
                            "@types/react-dom":  "^18.2.19",
                            "@vitejs/plugin-react":  "^6.1.1",
                            "autoprefixer":  "^10.4.18",
                            "electron":  "^29.0.0",
                            "electron-builder":  "^24.13.0",
                            "postcss":  "^8.4.35",
                            "tailwindcss":  "^3.4.1",
                            "typescript":  "^5.9.3",
                            "vite":  "^8.3.1"
                        },
    "build":  {
                  "appId":  "com.aiva.desktop",
                  "productName":  "AIVA",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "*.js",
                                "preload.js",
                                "speech-listener.ps1",
                                "kokoro-service.py",
                                "whisper-service.py",
                                "assets/**/*",
                                "renderer/**/*"
                            ],
                  "asarUnpack":  [
                                     "speech-listener.ps1",
                                     "kokoro-service.py",
                                     "whisper-service.py"
                                 ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "assets/icon.ico",
                              "artifactName":  "AIVA-Windows-Setup.${ext}"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "AIVA"
                           }
              },
    "author":  "AIVA"
}